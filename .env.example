# Telegram bot tokeni — @BotFather'dan olinadi. Haqiqiy tokenni bu faylga YOZMANG.
TELEGRAM_BOT_TOKEN="123456:BOT_TOKEN_SHU_YERGA"

# Birinchi support adminini tayinlash uchun bir martalik maxfiy kod.
# Botga "/admin <kod>" deb yozgan odam support admin bo'ladi.
ADMIN_SETUP_CODE="OZINGIZ_UYLAB_TOPING"

# Server porti (ixtiyoriy, standart: 3000)
PORT="3000"

# Ilova joylashgan manzil — bot xabarlaridagi havolalarda ishlatiladi
APP_URL="http://localhost:3000"

# ─── Faqat serverda kerak ───────────────────────────────────────────

# Ma'lumotlar bazasi. Berilmasa — diskdagi data/db.json ishlatiladi.
# Render kabi diski saqlanmaydigan hostlarda Postgres majburiy:
# DATABASE_URL="postgresql://user:parol@host/baza?sslmode=require"

# Bot rejimi: HTTPS manzil bo'lsa avtomatik webhook tanlanadi.
# Majburan long polling qilish uchun: BOT_MODE="polling"

# Ilova qaysi manzilda tinglaydi (proksi ortida 127.0.0.1)
# HOST="127.0.0.1"

# Ma'lumotlar katalogi (fayl rejimida)
# DATA_DIR="/var/lib/instacollab"
