# InstaCollab UZ — teskari proksi va avtomatik HTTPS.
#
# Bu fayl /etc/caddy/conf.d/instacollab.caddy ga joylanadi va asosiy
# Caddyfile'ga faqat bitta `import` qatori qo'shiladi — serverdagi boshqa
# saytlaringizning sozlamalariga tegilmaydi.
#
# Caddy Let's Encrypt sertifikatini o'zi oladi va o'zi yangilab turadi.

{{DOMAIN}} {
	encode zstd gzip

	# Ilova Node jarayoniga uzatiladi.
	reverse_proxy 127.0.0.1:{{PORT}} {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Telegram Mini App uchun zarur: sahifa Telegram ichida iframe'da ochiladi.
	header {
		# Brauzer MIME turini o'zi taxmin qilmasin.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# HSTS — bir yil davomida faqat HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Server versiyasini oshkor qilmaymiz.
		-Server
	}

	log {
		output file /var/log/caddy/instacollab.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
