{
  "name": "instacollab-uz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:bot": "tsx scripts/bot-selftest.ts",
    "test:storage": "tsx scripts/storage-selftest.ts",
    "test": "npm run test:storage && npm run test:webhook && npm run test:bot && npm run build && npm run test:visibility && npm run test:admin && npm run test:community",
    "test:webhook": "tsx scripts/webhook-selftest.ts",
    "test:visibility": "tsx scripts/visibility-selftest.ts",
    "test:admin": "tsx scripts/admin-selftest.ts",
    "test:community": "tsx scripts/community-selftest.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": "22.x"
  }
}
